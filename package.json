{
  "name": "iruna-stars",
  "private": true,
  "version": "0.1.0",
  "description": "Waterpolo Iruña Stars 26-27",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "datos": "tsx tools/datos/cli.ts",
    "rivales": "tsx tools/rivales/cli.ts",
    "dev": "npm run datos && vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "vite build",
    "build:single": "vite build --mode single",
    "build": "npm run datos && npm run typecheck && npm run build:web && npm run build:single && tsx tools/build/postbuild.ts",
    "preview": "vite preview",
    "sim": "tsx tools/sim/cli.ts"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
